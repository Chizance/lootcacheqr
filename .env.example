# Copy this file to .env and fill in your own Supabase project values.
# .env is gitignored — it will never be committed.
#
# Get these from: Supabase Dashboard > Project Settings > Data API
#   VITE_SUPABASE_URL      -> "Project URL"
#   VITE_SUPABASE_ANON_KEY -> "anon public" key (NOT the service_role key)
#
# The anon key is safe to expose in the browser — Supabase access control
# happens via Row Level Security policies (see supabase/schema.sql), not by
# keeping this key secret.
#
# Do NOT put your Anthropic API key here. It never goes in frontend code —
# see docs/CLAUDE_API_KEY.md for where it actually goes.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
